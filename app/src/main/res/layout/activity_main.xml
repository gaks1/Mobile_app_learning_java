<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_tint"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="MIAMI SUPERMARKET"
        android:background="@android:color/white"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp"
        android:text="ITEM"
        android:background="@android:color/white"
        android:textColor="@color/black"
        android:gravity="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/textView3"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp"
        android:text="UNIT PRICE"
        android:background="@android:color/white"
        android:textColor="@color/black"
        android:gravity="center"
        app:layout_constraintLeft_toRightOf="@id/textView2"
        app:layout_constraintRight_toLeftOf="@id/textView4"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp"
        android:text="QUANTITY"
        android:background="@android:color/white"
        android:textColor="@color/black"
        android:gravity="center"
        app:layout_constraintLeft_toRightOf="@id/textView3"
        app:layout_constraintRight_toLeftOf="@id/textView5"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp"
        android:text="TOTAL"
        android:background="@android:color/white"
        android:textColor="@color/black"
        android:gravity="center"
        app:layout_constraintLeft_toRightOf="@id/textView4"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView" />

    <!-- Row -->
    <Spinner
        android:id="@+id/spinner1"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/white"
        app:layout_constraintHorizontal_weight="2.5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/tvUnitPrice1"
        app:layout_constraintTop_toBottomOf="@id/textView2" />

    <TextView
        android:id="@+id/tvUnitPrice1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintLeft_toRightOf="@id/spinner1"
        app:layout_constraintRight_toLeftOf="@id/etQty1"
        app:layout_constraintTop_toTopOf="@id/spinner1" />

    <EditText
        android:id="@+id/etQty1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:inputType="number"
        android:background="@android:color/white"
        android:textColor="@color/black"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintLeft_toRightOf="@id/tvUnitPrice1"
        app:layout_constraintRight_toLeftOf="@id/tvTotal1"
        app:layout_constraintTop_toTopOf="@id/spinner1" />

    <TextView
        android:id="@+id/tvTotal1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner1"
        app:layout_constraintHorizontal_weight="1.8"
        app:layout_constraintLeft_toRightOf="@id/etQty1"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/spinner1" />

    <!-- ROW 2 -->
    <Spinner
        android:id="@+id/spinner2"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/white"
        app:layout_constraintHorizontal_weight="2.5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/tvUnitPrice2"
        app:layout_constraintTop_toBottomOf="@id/spinner1" />

    <TextView
        android:id="@+id/tvUnitPrice2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner2"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintLeft_toRightOf="@id/spinner2"
        app:layout_constraintRight_toLeftOf="@id/etQty2"
        app:layout_constraintTop_toTopOf="@id/spinner2" />

    <EditText
        android:id="@+id/etQty2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:inputType="number"
        android:background="@android:color/white"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner2"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintLeft_toRightOf="@id/tvUnitPrice2"
        app:layout_constraintRight_toLeftOf="@id/tvTotal2"
        app:layout_constraintTop_toTopOf="@id/spinner2" />

    <TextView
        android:id="@+id/tvTotal2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner2"
        app:layout_constraintHorizontal_weight="1.8"
        app:layout_constraintLeft_toRightOf="@id/etQty2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/spinner2" />

    <!-- ROW 3 -->
    <Spinner
        android:id="@+id/spinner3"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/white"
        app:layout_constraintHorizontal_weight="2.5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/tvUnitPrice3"
        app:layout_constraintTop_toBottomOf="@id/spinner2" />

    <TextView
        android:id="@+id/tvUnitPrice3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner3"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintLeft_toRightOf="@id/spinner3"
        app:layout_constraintRight_toLeftOf="@id/etQty3"
        app:layout_constraintTop_toTopOf="@id/spinner3" />

    <EditText
        android:id="@+id/etQty3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:inputType="number"
        android:background="@android:color/white"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner3"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintLeft_toRightOf="@id/tvUnitPrice3"
        app:layout_constraintRight_toLeftOf="@id/tvTotal3"
        app:layout_constraintTop_toTopOf="@id/spinner3" />

    <TextView
        android:id="@+id/tvTotal3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner3"
        app:layout_constraintHorizontal_weight="1.8"
        app:layout_constraintLeft_toRightOf="@id/etQty3"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/spinner3" />

    <!-- ROW 4 -->
    <Spinner
        android:id="@+id/spinner4"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/white"
        app:layout_constraintHorizontal_weight="2.5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/tvUnitPrice4"
        app:layout_constraintTop_toBottomOf="@id/spinner3" />

    <TextView
        android:id="@+id/tvUnitPrice4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner4"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintLeft_toRightOf="@id/spinner4"
        app:layout_constraintRight_toLeftOf="@id/etQty4"
        app:layout_constraintTop_toTopOf="@id/spinner4" />

    <EditText
        android:id="@+id/etQty4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:inputType="number"
        android:background="@android:color/white"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner4"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintLeft_toRightOf="@id/tvUnitPrice4"
        app:layout_constraintRight_toLeftOf="@id/tvTotal4"
        app:layout_constraintTop_toTopOf="@id/spinner4" />

    <TextView
        android:id="@+id/tvTotal4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner4"
        app:layout_constraintHorizontal_weight="1.8"
        app:layout_constraintLeft_toRightOf="@id/etQty4"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/spinner4" />

    <!-- ROW 5 -->
    <Spinner
        android:id="@+id/spinner5"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/white"
        app:layout_constraintHorizontal_weight="2.5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/tvUnitPrice5"
        app:layout_constraintTop_toBottomOf="@id/spinner4" />

    <TextView
        android:id="@+id/tvUnitPrice5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner5"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintLeft_toRightOf="@id/spinner5"
        app:layout_constraintRight_toLeftOf="@id/etQty5"
        app:layout_constraintTop_toTopOf="@id/spinner5" />

    <EditText
        android:id="@+id/etQty5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:background="@android:color/white"
        android:textColor="@color/black"
        android:inputType="number"
        app:layout_constraintBottom_toBottomOf="@id/spinner5"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintLeft_toRightOf="@id/tvUnitPrice5"
        app:layout_constraintRight_toLeftOf="@id/tvTotal5"
        app:layout_constraintTop_toTopOf="@id/spinner5" />

    <TextView
        android:id="@+id/tvTotal5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="0.00"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@id/spinner5"
        app:layout_constraintHorizontal_weight="1.8"
        app:layout_constraintLeft_toRightOf="@id/etQty5"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/spinner5" />

    <Button
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="360dp"
        android:text="GRAND TOTAL"
        android:backgroundTint="@color/white"
        android:textColor="@color/black"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/textView6"
        app:layout_constraintTop_toBottomOf="@id/textView2" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="360dp"
        android:background="@android:color/white"
        android:textColor="@color/black"
        android:gravity="center"
        android:text="0.00"
        app:layout_constraintLeft_toRightOf="@id/button"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView3" />

    <Button
        android:id="@+id/button2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Receipt"
        android:backgroundTint="@color/white"
        android:textColor="@color/black"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button"
        />

</androidx.constraintlayout.widget.ConstraintLayout>